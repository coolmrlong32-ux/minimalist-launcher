    </item>
    <item android:left="28dp" android:right="24dp" android:top="49dp" android:bottom="49dp">
        <shape>
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:left="28dp" android:right="44dp" android:top="68dp" android:bottom="30dp">
        <shape>
            <solid android:color="#FFA78BFA"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
</layer-list>
